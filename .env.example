# ==============================================================================
# CAMPUS CONNECT — ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# Copy this file to .env for local development or set in your deployment pipeline.
#
# IMPORTANT:
# - PUBLIC VARIABLES (VITE_*) are bundled into client JavaScript and visible in browser.
# - SERVER-ONLY SECRETS must NEVER be committed or prefixed with VITE_.
#   Set them via `supabase secrets set KEY=VALUE` on your independent Supabase project.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC VARIABLES (Safe for browser / Vite client)
# ------------------------------------------------------------------------------
# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anonymous (public) API key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Your Supabase project reference identifier
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (SUPABASE EDGE FUNCTIONS / BACKEND ENVIRONMENT)
# NEVER EXPOSE TO CLIENT BROWSER!
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Required by administrative & background Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared secret for administrative bootstrapping endpoints (ensure-admin-account / bootstrap-clean-reset)
# SETUP_SECRET=your-secure-random-setup-secret-min-32-chars

# Shared secret for scheduled cron notification executions
# NOTIFICATION_CRON_SECRET=your-secure-random-cron-secret-min-32-chars

# Web Push VAPID Public Key (base64url encoded P-256 public key)
# VAPID_PUBLIC_KEY=your-vapid-public-key

# Web Push VAPID Private Key (base64url encoded PKCS#8 private key)
# VAPID_PRIVATE_KEY=your-vapid-private-key

# Web Push Subject (mailto: URL or contact website)
# VAPID_SUBJECT=mailto:admin@yourcollege.edu

# Root Administrator credentials for initial account bootstrap
# ADMIN_EMAIL=admin@yourcollege.edu
# ADMIN_PASSWORD=your-initial-admin-password
# SUPER_ADMIN_EMAIL=superadmin@yourcollege.edu
# SUPER_ADMIN_PASSWORD=your-initial-super-admin-password
