<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly disallow all cleartext HTTP traffic across the entire application -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Pinned domain configuration for trusted Campus Connect production servers -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">campusconnect.indevs.in</domain>
        <domain includeSubdomains="true">supabase.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
