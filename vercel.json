{
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=3600, public"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/events/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|whatsapp|twitterbot|telegrambot|slackbot|linkedinbot|discordbot|embedly|quora link preview|pinterest).*"
        }
      ],
      "destination": "/api/og-event?id=:id"
    },
    {
      "source": "/((?!\\.well-known/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
